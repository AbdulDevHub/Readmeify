{
  "functions": {
    "api/*.js": {
      "memory": 128,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/profile.svg",
      "destination": "/api/profile-3d"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://github.com/AbdulDevHub/Readmeify"
    }
  ]
}
